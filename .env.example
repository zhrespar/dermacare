# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development

# PostgreSQL (docker-compose uses these)
POSTGRES_USER=dermacare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dermacare
DATABASE_URL=postgresql+psycopg://dermacare:change-me@localhost:5432/dermacare

# API
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=8

# Analysis backend: mock | torch  (torch requires trained weights)
ANALYSIS_BACKEND=mock

# LLM explanations: disabled | anthropic | openai | gemini
# Disabled by default. Set the model id your account can use; keys stay in .env only.
LLM_PROVIDER=disabled
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Current list prices (USD per 1M tokens) for cost estimates; leave empty if unknown.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# RAG: store memory|pgvector, embeddings hashing (dev/test only) | sentence_transformers
RAG_STORE=memory
RAG_EMBEDDING_BACKEND=hashing
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIM=384
