# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development

# PostgreSQL (docker-compose uses these)
POSTGRES_USER=dermacare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dermacare
DATABASE_URL=postgresql+psycopg://dermacare:change-me@localhost:5432/dermacare

# API
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=8

# Analysis backend: mock | torch  (torch requires trained weights)
ANALYSIS_BACKEND=mock

# LLM explanations (RAG): disabled | anthropic | openai | local
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
